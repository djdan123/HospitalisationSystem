# ============================================================
# SERVICE ACCUEIL - Configuration
# ============================================================
spring.application.name=accueil-service

# Server IP (machine serveur)
server.ip=192.168.1.10

# gRPC Port
grpc.accueil.port=50051

# Base de données MySQL
spring.datasource.url=jdbc:mysql://192.168.1.10:3306/hospital_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=hospital
spring.datasource.password=hospital123
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Logging
logging.level.root=INFO
logging.level.com.hospital=DEBUG
logging.level.org.hibernate.SQL=WARN
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
