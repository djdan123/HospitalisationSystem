<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.controller.PharmacieController"
      spacing="16" style="-fx-padding: 0;">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <CheckBox fx:id="onlyAvailable" text="Disponibles uniquement" onAction="#onRefresh"/>
        <Button text="Actualiser" styleClass="btn-secondary" onAction="#onRefresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouveau médicament" styleClass="btn-success" onAction="#onNew"/>
        <Button text="Entrée / Sortie stock" styleClass="btn-primary" onAction="#onUpdateStock"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colCode" text="Code" prefWidth="100"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="180"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
            <TableColumn fx:id="colPrix" text="Prix" prefWidth="90"/>
            <TableColumn fx:id="colUnite" text="Unité" prefWidth="80"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: #64748b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>
</VBox>
