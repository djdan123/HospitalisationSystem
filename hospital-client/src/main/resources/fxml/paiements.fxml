<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.controller.PaiementController"
      spacing="16" style="-fx-padding: 0;">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="patientIdField" promptText="ID patient..." prefWidth="140"/>
        <Button text="Charger factures" styleClass="btn-primary" onAction="#onLoadByPatient"/>
        <Button text="Actualiser" styleClass="btn-secondary" onAction="#onRefresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouvelle facture" styleClass="btn-success" onAction="#onNewFacture"/>
        <Button text="Enregistrer paiement" styleClass="btn-primary" onAction="#onPay"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colNumero" text="N° Facture" prefWidth="140"/>
            <TableColumn fx:id="colPatient" text="Patient ID" prefWidth="100"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
            <TableColumn fx:id="colPaye" text="Payé" prefWidth="100"/>
            <TableColumn fx:id="colRestant" text="Restant" prefWidth="100"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="140"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Saisissez un ID patient ou créez une facture" style="-fx-text-fill: #64748b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>
</VBox>
